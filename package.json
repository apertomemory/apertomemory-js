{
  "name": "apertomemory",
  "version": "0.2.1",
  "description": "TypeScript implementation of the ApertoMemory format (format_version 2): portable, client-side-encrypted, user-owned AI memory with signed, author-bound provenance (draft-ferro-apertomemory)",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai",
    "memory",
    "encryption",
    "cose",
    "cbor",
    "portability",
    "apertomemory",
    "amem"
  ],
  "author": "Andrea Ferro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apertomemory/apertomemory-js.git"
  },
  "homepage": "https://apertomemory.org",
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "cbor2": "^2.0.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}